{{template "repo/settings/layout_head" (dict "ctxData" . "pageClass" "repository settings lfs")}}
	<div class="repo-setting-content">
		<h4 class="ui top attached header">
			{{ctx.Locale.Tr "repo.settings.lfs_pointers.found" .NumPointers .NumAssociated .NumNotAssociated .NumNoExist}}
				<div class="ui right">
				</div>
			</div>
		</h4>
		<div class="ui attached segment filter-bar">
			<div class="filler"></div>
			{{if gt .NumAssociated 0}}
				<button id="lfs-files-delete-button" class="ui red show-modal button" data-modal="#lfs-files-delete">
					{{svg "octicon-trash"}} {{ctx.Locale.Tr "repo.settings.lfs.pointers.delete_selection"}}
				</button>
			{{end}}
			{{if gt .NumAssociatable 0}}
				<form class="ui form" method="post" action="{{$.Link}}/associate">
					{{range .Pointers}}
						{{if .Associatable}}
							<input type="hidden" name="oid" value="{{.Blob.Pointer.Oid}} {{.Blob.Pointer.Size}}">
						{{end}}
					{{end}}
					<button id="lfs-files-associate-button" class="ui primary button">{{ctx.Locale.Tr "repo.settings.lfs_pointers.associateAccessible" $.NumAssociatable}}</button>
				</form>
			{{end}}
			<form class="ui form ignore-dirty" id="lfs-pointers-search-form">
				<!-- Right Menu -->
				{{/* This misses the 'menu' entry, floated messes up everything */}}
				<div class="ui right floated secondary menu filter">
					<!-- Status Filter Menu Item -->
					<div class="ui dropdown type jump item">
						<span class="text">{{ctx.Locale.Tr "admin.users.list_status_filter.menu_text"}}</span>
						{{svg "octicon-triangle-down" 14 "dropdown icon"}}
						<div class="menu">
							<a class="item j-reset-pointer-filter">{{ctx.Locale.Tr "admin.users.list_status_filter.reset"}}</a>
							<div class="divider"></div>
							<label class="item"><input type="radio" name="pointer_filter[in_repo]" value="1"> {{ctx.Locale.Tr "repo.settings.lfs.pointers.inRepo"}}</label>
							<label class="item"><input type="radio" name="pointer_filter[in_repo]" value="0"> {{ctx.Locale.Tr "repo.settings.lfs.pointers.inRepo.not"}}</label>
							<div class="divider"></div>
							<label class="item"><input type="radio" name="pointer_filter[exists]" value="1"> {{ctx.Locale.Tr "repo.settings.lfs.pointers.exists"}}</label>
							<label class="item"><input type="radio" name="pointer_filter[exists]" value="0"> {{ctx.Locale.Tr "repo.settings.lfs.pointers.exists.not"}}</label>
							<div class="divider"></div>
							<label class="item"><input type="radio" name="pointer_filter[accessible]" value="1"> {{ctx.Locale.Tr "repo.settings.lfs.pointers.accessible"}}</label>
							<label class="item"><input type="radio" name="pointer_filter[accessible]" value="0"> {{ctx.Locale.Tr "repo.settings.lfs.pointers.accessible.not"}}</label>
						</div>
					</div>
				</div>
			</form>
		</div>
		<form id="lfs-files-delete-form" action="{{$.LFSFilesLink}}/delete" method="POST">
			<div class="ui attached segment">
				<table id="lfs-files-table" class="ui very basic table unstackable">
					<thead>
						<tr>
							<th>
								<input
									class="select-all" type="checkbox"
									aria-label="{{ctx.Locale.Tr "repo.settings.lfs.pointers.select_all"}}"
									{{if eq .NumAssociated 0}}disabled{{end}}
									data-select-all-name="oid"
								/>
							</th>
							<th class="three wide">{{ctx.Locale.Tr "repo.settings.lfs_pointers.sha"}}</th>
							<th class="three wide">{{ctx.Locale.Tr "repo.settings.lfs_pointers.oid"}}</th>
							<th class="two wide" data-tooltip-content="{{ctx.Locale.Tr "repo.settings.lfs.pointers.inRepo"}}">{{ctx.Locale.Tr "repo.settings.lfs.pointers.inRepo"}}</th>
							<th class="two wide" data-tooltip-content="{{ctx.Locale.Tr "repo.settings.lfs.pointers.exists"}}">{{ctx.Locale.Tr "repo.settings.lfs.pointers.exists"}}</th>
							<th class="two wide" data-tooltip-content="{{ctx.Locale.Tr "repo.settings.lfs.pointers.accessible"}}">{{ctx.Locale.Tr "repo.settings.lfs.pointers.accessible"}}</th>
							<th class="four wide"></th>
						</tr>
					</thead>
					<tbody>
						{{range .Pointers}}
							<tr>
								<td>
									<input
										type="checkbox"
										{{if not .InRepo}}disabled class="gray"{{end}}
										name="oid" value="{{.Blob.Pointer.Oid}}" aria-label="{{ShortSha .Blob.Pointer.Oid}}"
									/>
								</td>
								<td>
									<a href="{{$.RepoLink}}/raw/blob/{{.Blob.Hash}}" rel="nofollow" target="_blank" title="{{.Blob.Hash}}" class="ui button tw-font-mono">
										{{ShortSha .Blob.Hash}}
									</a>
								</td>
								<td>
								<a {{if and .Exists .InRepo}}href="{{$.LFSFilesLink}}/show/{{.Blob.Pointer.Oid}}" rel="nofollow" target="_blank"{{end}} title="{{.Blob.Pointer.Oid}}" class="ui brown button tw-font-mono">
										{{ShortSha .Blob.Pointer.Oid}}
									</a>
								</td>
								<td>{{if .InRepo}}{{svg "octicon-check"}}{{else}}{{svg "octicon-x"}}{{end}}</td>
								<td>{{if .Exists}}{{svg "octicon-check"}}{{else}}{{svg "octicon-x"}}{{end}}</td>
								<td>{{if .Accessible}}{{svg "octicon-check"}}{{else}}{{svg "octicon-x"}}{{end}}</td>
								<td class="tw-text-right">
									<a class="ui primary button" href="{{$.LFSFilesLink}}/find?oid={{.Blob.Pointer.Oid}}&size={{.Blob.Pointer.Size}}&sha={{.Blob.Hash}}">{{ctx.Locale.Tr "repo.settings.lfs_findcommits"}}</a>
								</td>
							</tr>
						{{else}}
							<tr>
								<td colspan="6" class="tw-text-center">{{ctx.Locale.Tr "repo.settings.lfs.no_pointers"}}</td>
							</tr>
						{{end}}
					</tbody>
				</table>
			</div>
		</form>
	</div>
<dialog class="modal" id="lfs-files-delete">
	<article>
		<header>
			{{svg "octicon-trash"}}
			{{ctx.Locale.Tr "repo.settings.lfs.pointers.delete.modal.header"}}
		</header>
		<div class="content">
			<span>{{ctx.Locale.Tr "repo.settings.lfs.pointers.delete.modal.description"}}</span>
		</div>
		<div class="actions">
			<button type="button" class="ui cancel button">{{svg "octicon-x"}} {{ctx.Locale.Tr "settings.cancel"}}</button>
			<button type="submit" class="ui red button" form="lfs-files-delete-form">{{svg "octicon-trash"}} {{ctx.Locale.Tr "org.settings.confirm_delete_account"}}</button>
		</div>
	</article>
</dialog>
{{template "repo/settings/layout_footer" .}}
