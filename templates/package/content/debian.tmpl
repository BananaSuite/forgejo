{{if eq .PackageDescriptor.Package.Type "debian"}}
	<h4 class="ui top attached header">{{ctx.Locale.Tr "packages.installation"}}</h4>
	<div class="ui attached segment">
		<div class="ui form">
			<div class="field">
				<label>{{svg "octicon-terminal" 16 "tw-mr-2"}}{{ctx.Locale.Tr "packages.common.registry"}}</label>
				<div class="markup"><pre class="code-block"><code>sudo curl <origin-url data-url="{{AppSubUrl}}/api/packages/{{$.PackageDescriptor.Owner.Name}}/debian/repository.key"></origin-url> -o /etc/apt/keyrings/forgejo-{{$.PackageDescriptor.Owner.Name}}.asc
echo "deb [signed-by=/etc/apt/keyrings/forgejo-{{$.PackageDescriptor.Owner.Name}}.asc] <origin-url data-url="{{AppSubUrl}}/api/packages/{{$.PackageDescriptor.Owner.Name}}/debian"></origin-url> $distribution $component" | sudo tee -a /etc/apt/sources.list.d/forgejo.list
sudo apt update</code></pre></div>
				<p>{{ctx.Locale.Tr "packages.debian.registry.info"}}</p>
			</div>
			<div class="field">
				<label>{{svg "octicon-terminal" 16 "tw-mr-2"}}{{ctx.Locale.Tr "packages.common.install"}}</label>
				<div class="markup">
					<pre class="code-block"><code>sudo apt install {{$.PackageDescriptor.Package.Name}}={{$.PackageDescriptor.Version.Version}}</code></pre>
				</div>
			</div>
			<div class="field">
				<label>{{ctx.Locale.Tr "packages.registry.documentation" "Debian" (AppDocsURL "user/packages/debian/")}}</label>
			</div>
		</div>
	</div>

	<h4 class="ui top attached header">{{ctx.Locale.Tr "packages.common.repository"}}</h4>
	<div class="ui attached segment">
		<table class="ui single line very basic table">
			<tbody>
				<tr>
					<td class="collapsing"><h5>{{ctx.Locale.Tr "packages.debian.repository.distributions"}}</h5></td>
					<td>{{StringUtils.Join .Distributions ", "}}</td>
				</tr>
				<tr>
					<td class="collapsing"><h5>{{ctx.Locale.Tr "packages.debian.repository.components"}}</h5></td>
					<td>{{StringUtils.Join .Components ", "}}</td>
				</tr>
				<tr>
					<td class="collapsing"><h5>{{ctx.Locale.Tr "packages.debian.repository.architectures"}}</h5></td>
					<td>{{StringUtils.Join .Architectures ", "}}</td>
				</tr>
			</tbody>
		</table>
	</div>

	{{$description := .PackageDescriptor.Metadata.DescriptionSynopsisAndBody}}
	{{if or $description.Synopsis $description.BodyMarkdown}}
		<h4 class="ui top attached header">{{ctx.Locale.Tr "packages.about"}}</h4>
		{{if $description.Synopsis -}}
			<div class="ui attached segment">{{$description.Synopsis}}</div>
		{{- end}}
		{{- if $description.BodyMarkdown -}}
			<div class="ui attached segment markup">{{RenderMarkdownToHtml $.Context $description.BodyMarkdown}}</div>
		{{- end}}
	{{end}}

	{{$depends := .PackageDescriptor.Metadata.GetDepends}}
	{{if or $depends .PackageDescriptor.Metadata.Suggests .PackageDescriptor.Metadata.PreDepends .PackageDescriptor.Metadata.Breaks .PackageDescriptor.Metadata.Conflicts .PackageDescriptor.Metadata.BuiltUsing}}
		<h4 class="ui top attached header">{{ctx.Locale.Tr "packages.dependencies"}}</h4>
		{{if $depends}}
			<div class="ui attached segment">
				<h5>Depends</h5>
				{{template "dependencies" $depends}}
			</div>
		{{end}}
		{{if .PackageDescriptor.Metadata.Suggests}}
			<div class="ui attached segment">
				<h5>Suggests</h5>
				{{template "dependencies" .PackageDescriptor.Metadata.Suggests}}
			</div>
		{{end}}
		{{if .PackageDescriptor.Metadata.Recommends}}
			<div class="ui attached segment">
				<h5>Recommends</h5>
				{{template "dependencies" .PackageDescriptor.Metadata.Recommends}}
			</div>
		{{end}}
		{{if .PackageDescriptor.Metadata.PreDepends}}
			<div class="ui attached segment">
				<h5>Pre-Depends</h5>
				{{template "dependencies" .PackageDescriptor.Metadata.PreDepends}}
			</div>
		{{end}}
		{{if .PackageDescriptor.Metadata.Breaks}}
			<div class="ui attached segment">
				<h5>Breaks</h5>
				{{template "dependencies" .PackageDescriptor.Metadata.Breaks}}
			</div>
		{{end}}
		{{if .PackageDescriptor.Metadata.Conflicts}}
			<div class="ui attached segment">
				<h5>Conflicts</h5>
				{{template "dependencies" .PackageDescriptor.Metadata.Conflicts}}
			</div>
		{{end}}
		{{if .PackageDescriptor.Metadata.Enhances}}
			<div class="ui attached segment">
				<h5>Enhances</h5>
				{{template "dependencies" .PackageDescriptor.Metadata.Enhances}}
			</div>
		{{end}}
		{{if .PackageDescriptor.Metadata.Provides}}
			<div class="ui attached segment">
				<h5>Provides</h5>
				{{template "dependencies" .PackageDescriptor.Metadata.Provides}}
			</div>
		{{end}}
		{{if .PackageDescriptor.Metadata.BuiltUsing}}
			<div class="ui attached segment">
				<h5>Built-Using</h5>
				{{template "dependencies" .PackageDescriptor.Metadata.BuiltUsing}}
			</div>
		{{end}}
	{{end}}
{{end}}

{{define "dependencies"}}
	<table class="ui single line very basic table">
		<thead>
			<tr>
				<th class="ten wide">{{ctx.Locale.Tr "packages.dependency.id"}}</th>
				<th class="six wide">{{ctx.Locale.Tr "packages.dependency.version"}}</th>
			</tr>
		</thead>
		<tbody>
			{{range .}}
			<tr>
				<td>{{if .IsAlternative}}<strong>or</strong> {{end}}{{.Name}}</td>
				<td>{{.VersionRequirement}}</td>
			</tr>
			{{end}}
		</tbody>
	</table>
{{end}}
