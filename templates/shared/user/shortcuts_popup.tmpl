<dialog id="shortcuts" class="modal">
	<header>
		<span>{{ctx.Locale.Tr "shortcuts.title"}}</span>
		<button type="button" class="ui compact icon button" aria-label="Close" command="close" commandfor="shortcuts">{{svg "octicon-x" 16}}</button>
	</header>
	<article class="content">
		<div class="tw-grid tw-grid-cols-1 sm:tw-grid-cols-2 tw-gap-4">
			<section class="ui segment tw-m-0">
				<h3 class="ui header">{{ctx.Locale.Tr "shortcuts.button.global"}}</h3>
				<div class="divider"></div>
				<div class="ui relaxed divided list">
					<div class="item">
						{{ctx.Locale.Tr "shortcuts.global.search"}}
						<div class="right floated tw-leading-none"><kbd>s</kbd></div>
					</div>
					<div class="item">
						{{ctx.Locale.Tr "shortcuts.global.popup"}}
						<div class="right floated tw-leading-none"><kbd>?</kbd></div>
					</div>
				</div>
			</section>
			<section class="ui segment tw-m-0">
				<h3 class="ui header">{{ctx.Locale.Tr "shortcuts.button.repo"}}</h3>
				<div class="divider"></div>
				<div class="ui relaxed divided list">
					<div class="item">
						{{ctx.Locale.Tr "repo.find_file.go_to_file"}}
						<div class="right floated tw-leading-none"><kbd>t</kbd></div>
					</div>
				</div>
			</section>
		</div>
		<div class="tw-mt-4">
			{{if .IsSigned}}
				<input type="checkbox"{{if .SignedUser.EnableShortcuts}} checked{{end}}>
			{{else}}
				<input type="checkbox" checked>
			{{end}}
			<label>{{ctx.Locale.Tr "shortcuts.enable"}}</label>
		</div>
	</article>
</dialog>
