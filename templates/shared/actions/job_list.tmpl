<div class="job-list-container">
	<h4 class="ui top attached header">
		{{ctx.Locale.Tr "actions.active_tasks.list_title"}} ({{ctx.Locale.Tr "admin.total" .Total}})
	</h4>
	<div class="ui attached segment">
		{{template "shared/actions/admin_filters" .}}
		<table class="ui very basic striped table unstackable">
			<thead>
				<tr>
					<th>{{ctx.Locale.Tr "actions.jobs.job"}}</th>
					<th>{{ctx.Locale.Tr "actions.runners.task_list.status"}}</th>
					<th>{{ctx.Locale.Tr "actions.runners.labels"}}</th>
					<th>{{ctx.Locale.Tr "actions.runners.task_list.runner"}}</th>
					<th>{{ctx.Locale.Tr "actions.runners.task_list.repository"}}</th>
					<th>{{ctx.Locale.Tr "actions.runners.task_list.commit"}}</th>
					<th>{{ctx.Locale.Tr "actions.jobs.created"}}</th>
				</tr>
			</thead>
			<tbody>
				{{range .Jobs}}
				<tr>
					<td>{{if .Run}}<a href="{{.Run.Link}}" target="_blank">{{.Name}}</a>{{else}}{{.Name}}{{end}}</td>
					<td><span class="ui label task-status-{{.Status.String}}">{{.Status.LocaleString ctx.Locale}}</span></td>
					<td>
						{{template "shared/actions/runs_on_labels" .RunsOn}}
						{{$missing := index $.MissingLabels .ID}}
						{{if $missing}}
							<span class="error" data-tooltip-content="{{ctx.Locale.Tr "actions.runs.no_matching_online_runner.helper" $missing}}">
								{{svg "octicon-alert" 16 "text red"}}
							</span>
						{{end}}
					</td>
					<td>
						{{$runner := index $.JobRunners .ID}}
						{{if not $runner}}
							&mdash;
						{{else if $runner.Deleted}}
							{{ctx.Locale.Tr "actions.runners.task_list.runner_deleted" $runner.Name}}
						{{else}}
							<a href="{{AppSubUrl}}/admin/actions/runners/{{$runner.ID}}">{{$runner.Name}}</a>
						{{end}}
					</td>
					{{if and .Run .Run.Repo}}
					<td><a href="{{.Run.Repo.Link}}" target="_blank">{{.Run.Repo.FullName}}</a></td>
					<td><strong><a href="{{.Run.Repo.CommitLink .CommitSHA}}" target="_blank">{{ShortSha .CommitSHA}}</a></strong></td>
					{{else}}
					<td>&mdash;</td>
					<td>{{ShortSha .CommitSHA}}</td>
					{{end}}
					<td>{{DateUtils.TimeSince .Created}}</td>
				</tr>
				{{end}}
				{{if not .Jobs}}
				<tr>
					<td colspan="7">{{ctx.Locale.Tr "actions.jobs.no_jobs"}}</td>
				</tr>
				{{end}}
			</tbody>
		</table>
		{{template "base/paginate" .}}
	</div>
</div>
