{{/* IsAdminTaskList adds the Job, Labels, Runner and Runtime columns of the "Past tasks" page in site administration. */}}
<table class="ui very basic striped table unstackable">
	<thead>
		<tr>
			<th>{{ctx.Locale.Tr "actions.runners.task_list.run"}}</th>
			<th>{{ctx.Locale.Tr "actions.runners.task_list.status"}}</th>
			{{if $.IsAdminTaskList}}
			<th>{{ctx.Locale.Tr "actions.jobs.job"}}</th>
			<th>{{ctx.Locale.Tr "actions.runners.labels"}}</th>
			<th>{{ctx.Locale.Tr "actions.runners.task_list.runner"}}</th>
			{{end}}
			<th>{{ctx.Locale.Tr "actions.runners.task_list.repository"}}</th>
			<th>{{ctx.Locale.Tr "actions.runners.task_list.commit"}}</th>
			{{if $.IsAdminTaskList}}
			<th>{{ctx.Locale.Tr "actions.runners.task_list.runtime"}}</th>
			{{end}}
			<th>{{ctx.Locale.Tr "actions.runners.task_list.done_at"}}</th>
		</tr>
	</thead>
	<tbody>
		{{range .Tasks}}
		<tr>
			<td><a href="{{.GetRunLink}}" target="_blank">{{.ID}}</a></td>
			<td><span class="ui label task-status-{{.Status.String}}">{{.Status.LocaleString ctx.Locale}}</span></td>
			{{if $.IsAdminTaskList}}
			<td>{{if .Job}}{{.Job.Name}}{{else}}&mdash;{{end}}</td>
			<td>{{if .Job}}{{template "shared/actions/runs_on_labels" .Job.RunsOn}}{{else}}&mdash;{{end}}</td>
			<td>
				{{$runner := index $.TaskRunners .RunnerID}}
				{{if not $runner}}
					&mdash;
				{{else if $runner.Deleted}}
					{{ctx.Locale.Tr "actions.runners.task_list.runner_deleted" $runner.Name}}
				{{else}}
					<a href="{{AppSubUrl}}/admin/actions/runners/{{$runner.ID}}">{{$runner.Name}}</a>
				{{end}}
			</td>
			{{end}}
			<td><a href="{{.GetRepoLink}}" target="_blank">{{.GetRepoName}}</a></td>
			<td>
				<strong><a href="{{.GetCommitLink}}" target="_blank">{{ShortSha .CommitSHA}}</a></strong>
			</td>
			{{if $.IsAdminTaskList}}
			<td>{{if .IsStopped}}{{.Duration}}{{else}}-{{end}}</td>
			{{end}}
			<td>{{if .IsStopped}}
				<span>{{DateUtils.TimeSince .Stopped}}</span>
				{{else}}-{{end}}</td>
		</tr>
		{{end}}
		{{if not .Tasks}}
		<tr>
			<td colspan="{{if $.IsAdminTaskList}}9{{else}}5{{end}}">{{ctx.Locale.Tr "actions.runners.task_list.no_tasks"}}</td>
		</tr>
		{{end}}
	</tbody>
</table>
